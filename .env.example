# FridgeFlow AI Backend Configuration
PORT=8000
ENVIRONMENT=development

# Open-Weight Gemma AI Model Configuration
# Compatible with Google DeepMind Gemma 3 (e.g. gemma3:4b, gemma3:12b) and PaliGemma 2
GEMMA_MODEL_NAME=gemma3:4b

# Local Ollama Inference Host
OLLAMA_HOST=http://localhost:11434

# Set to true to enforce offline calibrated culinary reference mode for testing/demo
FORCE_MOCK_VISION=false
