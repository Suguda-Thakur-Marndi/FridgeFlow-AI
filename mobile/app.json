{
  "expo": {
    "name": "FridgeFlow AI",
    "slug": "fridgeflow-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fridgeflow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.fridgeflow.ai",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F2FCF2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "FridgeFlow AI needs access to your photos to let you upload fridge pictures.",
          "cameraPermission": "FridgeFlow AI needs access to your camera to scan ingredients inside your fridge."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#04442F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
